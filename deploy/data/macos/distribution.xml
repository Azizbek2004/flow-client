<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Flow Installer</title>
    <license file="LICENSE"/>
    <choices-outline>
        <line choice="install"/>
        <line choice="uninstall"/>
    </choices-outline>
    <choice id="install" title="Install Flow" start_selected="true">
        <pkg-ref id="org.flow.client"/>
    </choice>
    <choice id="uninstall" title="Uninstall Flow" start_selected="false">
        <pkg-ref id="org.flow.uninstall"/>
    </choice>
    <pkg-ref id="org.flow.client" auth="Root" install-check="scripts/check_install.sh">Flow_install.pkg</pkg-ref>
    <pkg-ref id="org.flow.uninstall" auth="Root" install-check="scripts/check_uninstall.sh">Flow_uninstall_component.pkg</pkg-ref>
</installer-gui-script>
