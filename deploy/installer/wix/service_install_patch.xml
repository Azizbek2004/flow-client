<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <CPackWiXFragment Id="CM_CP_Flow_service.exe">
        <ServiceInstall
                Id="FlowServiceInstall"
                Name="Flow-service"
                DisplayName="Flow Service"
                Description="Service for Flow"
                Start="auto"
                Type="ownProcess"
                ErrorControl="normal"
                Vital="no">
            <ServiceDependency Id="BFE" />
            <ServiceDependency Id="nsi" />
        </ServiceInstall>
        <ServiceControl
                Id="FlowServiceControl"
                Name="Flow-service"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
    </CPackWiXFragment>
</CPackWiXPatch>