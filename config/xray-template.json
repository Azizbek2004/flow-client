{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [{
    "port": 10808,
    "listen": "127.0.0.1",
    "protocol": "socks",
    "settings": {
      "udp": true
    },
    "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
    }
  }],
  "outbounds": [{
    "protocol": "vless",
    "settings": {
      "vnext": [{
        "address": "{{SERVER_ADDRESS}}",
        "port": {{SERVER_PORT}},
        "users": [{
          "id": "{{USER_ID}}",
          "encryption": "none",
          "flow": "xtls-rprx-vision"
        }]
      }]
    },
    "streamSettings": {
      "network": "tcp",
      "security": "reality",
      "realitySettings": {
        "serverName": "{{SNI}}",
        "publicKey": "{{PUBLIC_KEY}}",
        "shortId": "{{SHORT_ID}}",
        "fingerprint": "chrome"
      }
    }
  }]
}
